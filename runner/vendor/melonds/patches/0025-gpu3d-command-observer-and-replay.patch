+void GPU3D::ExecuteReplayCommand(u32 command, const u32* params, u32 count) noexcept
+{
+    // The FIFO is bypassed: no IRQ, DMA or stall reaches the NDS.
+    CmdFIFOEntry entry {};
+    entry.Command = command;
+    if (count == 0)
+    {
+        ExecuteEntry(entry);
+        return;
+    }
+    for (u32 i = 0; i < count; i++)
+    {
+        entry.Param = params[i];
+        ExecuteEntry(entry);
+    }
+}
