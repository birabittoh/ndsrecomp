+    void CmdFIFOStall(CmdFIFOEntry entry) noexcept;
     CmdFIFOEntry CmdFIFORead() noexcept;
     void ExecuteEntry(CmdFIFOEntry entry) noexcept;
     void FinishWork(s32 cycles) noexcept;
